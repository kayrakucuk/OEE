# Copy to .env and adjust as needed. Defaults match docker-compose.yml, so an unmodified
# copy is enough to bring the stack up locally.
#
# These are local development credentials only.

POSTGRES_DB=linecore
POSTGRES_USER=linecore
POSTGRES_PASSWORD=linecore
POSTGRES_PORT=5432

RABBITMQ_USER=linecore
RABBITMQ_PASSWORD=linecore
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MQTT_PORT=1883
RABBITMQ_UI_PORT=15672
RABBITMQ_METRICS_PORT=15692

REDIS_PORT=6379
